# /etc/systemd/system/nova-sosyal.service
[Unit]
Description=NOVA Sosyal
After=network.target

[Service]
Type=simple
User=nova
WorkingDirectory=/opt/nova-sosyal
Environment=PORT=3000
Environment=DATA_DIR=/opt/nova-sosyal/data
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
